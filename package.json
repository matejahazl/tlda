{
    "name": "tlda",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -H 127.0.0.1 | pino-pretty",
        "build": "next build",
        "start": "next start -H 127.0.0.1",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest run --passWithNoTests",
        "test:browser": "playwright test",
        "test:browser:update": "playwright test --update-snapshots",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "1.6.0",
        "@google/genai": "3.0.0",
        "better-sqlite3": "13.0.3",
        "drizzle-orm": "0.45.4",
        "next": "16.4.3",
        "pino": "10.4.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "server-only": "0.0.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.64.1",
        "@tailwindcss/turbopack": "4.3.3",
        "@types/better-sqlite3": "9.6.0",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/parser": "8.72.1",
        "drizzle-kit": "0.31.11",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.3",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-tailwindcss": "4.4.0",
        "pino-pretty": "13.2.0",
        "prettier": "3.9.10",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vitest": "5.0.5"
    },
    "allowScripts": {
        "better-sqlite3@13.0.3": true
    }
}
