# mock | gemini | claude
LLM_PROVIDER=mock
# required unless mock, e.g. gemini-3.5-flash-lite or claude-opus-5-5
LLM_MODEL=
# required unless mock (Gemini: key from Google AI Studio; Claude: key from the Claude Console)
LLM_API_KEY=
# debug | info | warn | error (default info)
LOG_LEVEL=info
# SQLite file (default data/tlda.db)
DB_PATH=data/tlda.db
