# mock | gemini | openai-compatible
LLM_PROVIDER=mock
# required unless mock, e.g. gemini-3.5-flash-lite
LLM_MODEL=
# required unless mock (Gemini: key from Google AI Studio)
LLM_API_KEY=
# required for openai-compatible only
LLM_BASE_URL=
# debug | info | warn | error (default info)
LOG_LEVEL=info
